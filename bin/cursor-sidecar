#!/bin/sh
# Launches the Cursor SDK sidecar (sidecar/worker.py) with the plugin's private venv python.
DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PY="$DIR/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "cursor-subscription-directsdk: Cursor SDK runtime not installed. Run: hermes auth add cursor-subscription-directsdk" >&2
  exit 3
fi
unset PYTHONPATH PYTHONHOME VIRTUAL_ENV CURSOR_API_KEY
exec "$PY" -I "$DIR/sidecar/worker.py" "$@"
